{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "installCommand": "npm ci --include=dev",
    "buildCommand": "node scripts/vercel-composer.mjs && npm run build && node scripts/vercel-static.mjs",
    "outputDirectory": "vercel-static",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.9.0",
            "excludeFiles": "{node_modules/**,vercel-static/**,tests/**,docs/**,scripts/**,.github/**,.git/**,.env,.env.*,auth.json,storage/**,database/*.sqlite*,database/*.db,public/hot,public/storage/**,tmp/**,*-output.html}"
        }
    },
    "routes": [
        { "src": "/index\\.php", "dest": "/api/index.php" },
        { "handle": "filesystem" },
        { "src": "/(.*)", "dest": "/api/index.php" }
    ]
}
